# Copy to .env and adjust before running `docker compose up`.

ASPNETCORE_ENVIRONMENT=Production

# --- Identity provider (required for a working first boot) ---------------------------------
# Seeds the first OIDC provider into the database the first time the app boots. After that,
# providers are entirely managed via the admin page ("OIDC providers" section) and these
# values are no longer read - so it's fine to leave them as-is (or blank them) after upgrading.
# Authority is the provider's issuer URL (its OIDC discovery doc lives at
# "<authority>/.well-known/openid-configuration"); ClientId is a public SPA client with PKCE
# enabled and no client secret; Audience is the "aud" claim your provider puts in access tokens
# for that client (with Keycloak, this usually needs an audience mapper added to the client).
OIDC_DEFAULT_NAME=Default
OIDC_DEFAULT_AUTHORITY=https://your-idp.example.com/realms/markdown-hub
OIDC_DEFAULT_CLIENT_ID=markdown-hub
OIDC_DEFAULT_AUDIENCE=markdown-hub
OIDC_DEFAULT_REQUIRE_HTTPS_METADATA=true

# Optional - guarantees this username becomes an administrator the first time it signs in via
# the identity provider above, instead of relying on "whoever logs in first". Leave blank to
# skip (the first-ever login still becomes admin either way).
ADMIN_USERNAME=

# --- Storage ----------------------------------------------------------------------------------
# Where your Markdown hub lives on the host. Can be a relative path (created automatically)
# or an absolute path to an existing folder, e.g. F:/Notes.
HUB_HOST_PATH=./data/markdown

# --- Networking -------------------------------------------------------------------------------
API_PORT=8085
FRONTEND_PORT=8086
# Your real external origin (scheme + host, no trailing slash), if you're exposing this behind
# a domain - added to the API's allowed CORS origins alongside the localhost defaults.
FRONTEND_ORIGIN=

# --- AI-assisted editing (optional) - a local Ollama instance the API container can reach -----
# http://host.docker.internal:11434 assumes Ollama runs on the Docker host itself; point this
# at wherever it actually runs (another container, another machine) if that's not the case.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:20b
