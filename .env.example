# Copy to .env and adjust before running `docker compose up`.

ASPNETCORE_ENVIRONMENT=Production

# --- Administrator bootstrap (this is all you need for a working first boot) -----------------
# Creates the initial administrator account, with this password, the first time the app boots
# against an empty database. Local username/password sign-in always works - no external identity
# provider is required. Changing these later has NO effect on an account that already exists;
# manage the password from the admin page (or Account page) instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD for Docker/Podman secrets - if set and the file exists, it takes
# precedence. e.g. ADMIN_PASSWORD_FILE=/run/secrets/admin_password
ADMIN_PASSWORD_FILE=

# --- External identity provider (optional) -----------------------------------------------------
# Seeds ONE external OIDC provider into the database the first time the app boots, purely as a
# convenience - after that, providers (including this one) are entirely managed via the admin
# page ("Authentication providers" section), and these values are no longer read. Leave blank to
# skip entirely and add providers later through the admin UI instead (Google/GitHub/Facebook/
# Keycloak presets, or Generic OIDC/OAuth 2.0).
#
# Unlike the old SPA-driven flow, the API itself now performs the authorization-code exchange
# server-side, so a client secret is required and the provider's redirect URI must point at the
# API, not the frontend: "<api-origin>/api/auth/external/<name>/callback" (e.g.
# http://localhost:8085/api/auth/external/default/callback for local Docker Compose use).
OIDC_DEFAULT_NAME=Default
OIDC_DEFAULT_AUTHORITY=https://your-idp.example.com/realms/markdown-hub
OIDC_DEFAULT_CLIENT_ID=markdown-hub
OIDC_DEFAULT_CLIENT_SECRET=
OIDC_DEFAULT_AUDIENCE=markdown-hub
OIDC_DEFAULT_REQUIRE_HTTPS_METADATA=true

# Only needed if the API sits behind a reverse proxy that doesn't forward the original
# scheme/host, so the computed callback redirect URI above would otherwise be wrong.
AUTH_PUBLIC_API_ORIGIN=

# Optional - overrides the JWT signing key the API generates (and persists in its database) on
# first boot. Only needed for a multi-instance deployment where every instance must share one key.
JWT_SIGNING_KEY=

# How long a login session lasts before the user has to sign in again.
SESSION_LIFETIME_HOURS=168

# --- Storage ----------------------------------------------------------------------------------
# Where your Markdown hub lives on the host. Can be a relative path (created automatically)
# or an absolute path to an existing folder, e.g. F:/Notes.
HUB_HOST_PATH=./data/markdown

# --- Networking -------------------------------------------------------------------------------
API_PORT=8085
FRONTEND_PORT=8086
# Your real external origin (scheme + host, no trailing slash), if you're exposing this behind
# a domain - added to the API's allowed CORS origins alongside the localhost defaults.
FRONTEND_ORIGIN=

# --- AI-assisted editing (optional) - a local Ollama instance the API container can reach -----
# http://host.docker.internal:11434 assumes Ollama runs on the Docker host itself; point this
# at wherever it actually runs (another container, another machine) if that's not the case.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:20b
