{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.IdentityModel": "Debug",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Hub": {
    "MarkdownRoot": "/data/markdown",
    "BackupLocation": "/data/backups",
    "AllowedFileExtensions": [ ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg" ],
    "MaximumUploadSizeBytes": 20971520,
    "BackupSchedule": "0 0 3 * * *",
    "BackupsToRetain": 14
  },

  "OidcDefault": {
    "Name": "Default",
    "Authority": "http://keycloak:8080/realms/markdown-hub",
    "ClientId": "markdown-hub",
    "ClientSecret": "",
    "Audience": "markdown-hub",
    "RequireHttpsMetadata": false
  },

  "Sessions": {
    "LifetimeHours": 168
  },

  "Jwt": {
    "SigningKey": ""
  },

  "DataProtection": {
    "KeysPath": "/data/keys"
  },

  "Admin": {
    "Username": "",
    "Password": ""
  },

  "Ai": {
    "Ollama": {
      "BaseUrl": "http://host.docker.internal:11434",
      "Model": "gpt-oss:20b",
      "TimeoutSeconds": 60
    }
  },

  "ConnectionStrings": {
    "Default": "Data Source=/data/db/markdown-hub.db"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
